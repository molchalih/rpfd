{
  "name": "rpf",
  "displayName": "RPF Archives",
  "description": "Open a RAGE .rpf archive as a folder in the editor: entries edit and save as ordinary files, patched in place, rebuilt when you ask.",
  "version": "0.0.0",
  "license": "MIT OR Apache-2.0",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#F4F1EC",
    "theme": "light"
  },
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "rpf",
    "rage",
    "gta",
    "fivem",
    "ragemp",
    "archive",
    "modding"
  ],
  "main": "./dist/src/extension.js",
  "activationEvents": [
    "onFileSystem:rpf"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Mounting an archive starts the rpf binary on the archives this folder holds."
    }
  },
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "rpf.servers",
        "label": "RPF Archives"
      }
    ],
    "commands": [
      {
        "command": "rpf.mountArchive",
        "title": "Mount Archive as Folder",
        "category": "RPF"
      },
      {
        "command": "rpf.unmountArchive",
        "title": "Unmount Archive",
        "category": "RPF"
      },
      {
        "command": "rpf.saveArchive",
        "title": "Rebuild Archive",
        "category": "RPF"
      },
      {
        "command": "rpf.discardEdits",
        "title": "Discard Buffered Edits",
        "category": "RPF"
      },
      {
        "command": "rpf.verifyArchive",
        "title": "Verify Archive",
        "category": "RPF"
      },
      {
        "command": "rpf.handOff",
        "title": "Edit With Another Tool",
        "category": "RPF"
      },
      {
        "command": "rpf.endHandOff",
        "title": "Stop Watching Handed-Off Files",
        "category": "RPF"
      }
    ],
    "colors": [
      {
        "id": "rpf.modifiedResourceForeground",
        "description": "Colour of an entry with a buffered edit waiting to be written to the archive.",
        "defaults": {
          "dark": "gitDecoration.modifiedResourceForeground",
          "light": "gitDecoration.modifiedResourceForeground",
          "highContrast": "gitDecoration.modifiedResourceForeground"
        }
      },
      {
        "id": "rpf.addedResourceForeground",
        "description": "Colour of an entry this session created, waiting to be written to the archive.",
        "defaults": {
          "dark": "gitDecoration.addedResourceForeground",
          "light": "gitDecoration.addedResourceForeground",
          "highContrast": "gitDecoration.addedResourceForeground"
        }
      },
      {
        "id": "rpf.deletedResourceForeground",
        "description": "Colour of an entry with a buffered deletion waiting to be written to the archive.",
        "defaults": {
          "dark": "gitDecoration.deletedResourceForeground",
          "light": "gitDecoration.deletedResourceForeground",
          "highContrast": "gitDecoration.deletedResourceForeground"
        }
      },
      {
        "id": "rpf.renamedResourceForeground",
        "description": "Colour of an entry with a buffered rename waiting to be written to the archive.",
        "defaults": {
          "dark": "gitDecoration.renamedResourceForeground",
          "light": "gitDecoration.renamedResourceForeground",
          "highContrast": "gitDecoration.renamedResourceForeground"
        }
      }
    ],
    "resourceLabelFormatters": [
      {
        "scheme": "rpf",
        "formatting": {
          "label": "${path}",
          "separator": "/",
          "tildify": false,
          "workspaceSuffix": "rpf"
        }
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "rpf.mountArchive",
          "when": "resourceScheme == file && resourceExtname == .rpf",
          "group": "navigation@50"
        },
        {
          "command": "rpf.handOff",
          "when": "resourceScheme == rpf && !explorerResourceIsFolder",
          "group": "navigation@50"
        }
      ]
    },
    "configuration": {
      "title": "RPF Archives",
      "properties": {
        "rpf.binaryPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Absolute path to the `rpf` binary. Empty means: use the one bundled with this extension if there is one, otherwise the first `rpf` on `PATH`."
        },
        "rpf.handOff.extensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".ytd",
            ".ydr",
            ".yft",
            ".ycd",
            ".ynv",
            ".awc",
            ".dds",
            ".ydd",
            ".ypt",
            ".yed"
          ],
          "markdownDescription": "Entry extensions this extension will not try to edit itself. Opening one offers to extract it, watch it, and re-import it when it changes."
        },
        "rpf.handOff.directory": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Where handed-off files are written. Empty means a directory under the system temporary directory."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "check": "tsc -p . --noEmit",
    "test": "npm run build && node --test --test-timeout=60000 dist/test/*.test.js",
    "test:editor": "npm run build && node dist/test/editor/run.js",
    "package": "npm run build && node dist/scripts/vsix.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.101.0",
    "@vscode/test-electron": "^2.5.2",
    "typescript": "^5.9.0"
  }
}
